
import java.util.*;

public class Solution {
    public static boolean canWin(int leap, int[] game) {
        boolean[] visited = new boolean[game.length];
        return solve(0, leap, game, visited);
    }

    static boolean solve(int i, int leap, int[] game,
                         boolean[] visited) {
        if (i >= game.length)
            return true;

        if (i < 0 || game[i] == 1 || visited[i])
            return false;

        visited[i] = true;

        return solve(i + leap, leap, game, visited)
            || solve(i + 1, leap, game, visited)
            || solve(i - 1, leap, game, visited);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int q = sc.nextInt();

        while (q-- > 0) {
            int n = sc.nextInt();
            int leap = sc.nextInt();
            int[] game = new int[n];

            for (int i = 0; i < n; i++) {
                game[i] = sc.nextInt();
            }

            System.out.println(
                canWin(leap, game) ? "YES" : "NO"
            );
        }
    }
}
