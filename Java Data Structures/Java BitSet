
import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int m = sc.nextInt();

        BitSet[] b = {
            new BitSet(n),
            new BitSet(n)
        };

        for (int i = 0; i < m; i++) {
            String op = sc.next();
            int x = sc.nextInt();
            int y = sc.nextInt();

            if (op.equals("AND")) {
                b[x - 1].and(b[y - 1]);
            } else if (op.equals("OR")) {
                b[x - 1].or(b[y - 1]);
            } else if (op.equals("XOR")) {
                b[x - 1].xor(b[y - 1]);
            } else if (op.equals("FLIP")) {
                b[x - 1].flip(y);
            } else if (op.equals("SET")) {
                b[x - 1].set(y);
            }

            System.out.println(
                b[0].cardinality() + " " + b[1].cardinality()
            );
        }
    }
}
